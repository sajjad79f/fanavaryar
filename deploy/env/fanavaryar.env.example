# نمونه متغیرهای محیطی فناوریار
# کپی کنید به: /etc/fanavaryar/fanavaryar.env  و مقادیر را تنظیم کنید
# مالکیت: chown root:fanavaryar و chmod 640 (رمزها فقط برای سرویس خوانا باشند)

# آدرس گوش‌دادن برنامه — فقط localhost؛ کاربران از مسیر Nginx وارد می‌شوند
FANAVARYAR_ADDR=127.0.0.1:8080

# رشته اتصال PostgreSQL (رمز را عوض کنید!)
FANAVARYAR_DB_DSN=postgres://fanavaryar:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:5432/fanavaryar?sslmode=disable

# محیط اجرا: prod روی عملیاتی، test روی آزمایشی
FANAVARYAR_ENV=prod

# کوکی نشست فقط روی HTTPS — روی محیط عملیاتی با گواهی معتبر: true
# در محیط آزمایشی با گواهی Self-Signed موقتاً false بگذارید و بعد از اعتبار HTTPS برش‌گردانید true
FANAVARYAR_COOKIE_SECURE=true

# طول عمر نشست بر حسب ساعت (پیش‌فرض ۲۴)
FANAVARYAR_SESSION_TTL_HOURS=24

# پوشه فایل‌ها و PDFها (خارج از دیتابیس)
FANAVARYAR_FILES_DIR=/var/lib/fanavaryar/files

# پوشه فایل‌های ساخت‌شده فرانت‌اند (بعد از make web)
FANAVARYAR_WEB_DIR=/opt/fanavaryar/web/dist

# رمز اولین مدیر سامانه — فقط در نخستین اجرا لازم است و بعداً از سامانه عوض شود
# FANAVARYAR_ADMIN_PASSWORD=
